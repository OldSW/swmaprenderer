#version 450
#extension GL_ARB_gpu_shader_int64 : require

// Vulkan port of raster.cl; see that file for how the rasterizer works and why coverage is
// decided in 64-bit integers. The two are the same program in two languages and have to be
// changed together. Build the SPIR-V with:
//
//   glslc -O --target-env=vulkan1.1 raster.comp -o raster.spv

layout(local_size_x = 8, local_size_y = 8) in;

struct Tri
{
    int x[3];
    int y[3];
    float z[3];
    float texture[9];
    float hue[12];
    float normal[9];
    int spriteOffset;
    int spriteWidth;
    int spriteHeight;
    int flags;
    int pad;
};

layout(std430, set = 0, binding = 0) readonly buffer Tris { Tri tris[]; };
layout(std430, set = 0, binding = 1) readonly buffer BinStart { int binStart[]; };
layout(std430, set = 0, binding = 2) readonly buffer BinList { int binList[]; };
layout(std430, set = 0, binding = 3) readonly buffer Sprites { uint sprites[]; };
layout(std430, set = 0, binding = 4) readonly buffer Hues { uint hues[]; };
layout(std430, set = 0, binding = 5) writeonly buffer Output { uint outputPixels[]; };

layout(push_constant) uniform Params
{
    vec4 clearColor;
    int hueCount;
    int width;
    int height;
    int tilesX;
} params;

const int FIXED_ONE = 256;
const int TILE_SHIFT = 4;

int64_t edge(int ax, int ay, int bx, int by, int cx, int cy)
{
    return int64_t(bx - ax) * int64_t(cy - ay) - int64_t(by - ay) * int64_t(cx - ax);
}

float getLight(vec3 n)
{
    float lengthSquared = dot(n, n);
    if (lengthSquared < 1e-12)
        return 1.0;

    n = n / sqrt(lengthSquared);
    const vec3 lightDirection = vec3(0.0, 0.70710678, 0.70710678);
    float baseLight = max(dot(n, lightDirection), 0.0) / 2.0 + 0.5;
    float delta = baseLight - 0.85355339;
    return baseLight + (1.5 * delta - delta);
}

vec3 getRgb(float gray, int hue)
{
    if (hue < 0 || hue >= params.hueCount)
        return vec3(0.0);

    int index = clamp(int(gray * 32.0), 0, 31);
    uint rgba = hues[hue * 32 + index];
    return vec3(float(rgba & 0xFFu), float((rgba >> 8) & 0xFFu), float((rgba >> 16) & 0xFFu)) / 255.0;
}

uint toByte(float v)
{
    return uint(clamp(int(v * 255.0 + 0.5), 0, 255));
}

void main()
{
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= params.width || y >= params.height)
        return;

    int tile = (y >> TILE_SHIFT) * params.tilesX + (x >> TILE_SHIFT);
    int px = x * FIXED_ONE + FIXED_ONE / 2;
    int py = y * FIXED_ONE + FIXED_ONE / 2;

    vec4 color = params.clearColor;
    float depthBuffer = 1.0;

    int end = binStart[tile + 1];
    for (int i = binStart[tile]; i < end; i++)
    {
        int index = binList[i];

        int x0 = tris[index].x[0], y0 = tris[index].y[0];
        int x1 = tris[index].x[1], y1 = tris[index].y[1];
        int x2 = tris[index].x[2], y2 = tris[index].y[2];

        int64_t area = edge(x0, y0, x1, y1, x2, y2);
        int64_t e0 = edge(x1, y1, x2, y2, px, py);
        int64_t e1 = edge(x2, y2, x0, y0, px, py);
        int64_t e2 = area - e0 - e1;

        if (area < 0)
        {
            area = -area; e0 = -e0; e1 = -e1; e2 = -e2;
        }
        if (e0 < 0 || e1 < 0 || e2 < 0)
            continue;

        float farea = float(area);
        float w0 = float(e0) / farea;
        float w1 = float(e1) / farea;
        float w2 = float(e2) / farea;

        float depth = w0 * tris[index].z[0] + w1 * tris[index].z[1] + w2 * tris[index].z[2];
        if (depth < 0.0 || depth > 1.0)
            continue;
        if (depth >= depthBuffer)
            continue;

        float u = w0 * tris[index].texture[0] + w1 * tris[index].texture[3] + w2 * tris[index].texture[6];
        float v = w0 * tris[index].texture[1] + w1 * tris[index].texture[4] + w2 * tris[index].texture[7];
        float flag = w0 * tris[index].texture[2] + w1 * tris[index].texture[5] + w2 * tris[index].texture[8];

        int spriteWidth = tris[index].spriteWidth;
        int spriteHeight = tris[index].spriteHeight;
        int sx = clamp(int(u * float(spriteWidth)), 0, spriteWidth - 1);
        int sy = clamp(int(v * float(spriteHeight)), 0, spriteHeight - 1);
        uint texel = sprites[tris[index].spriteOffset + sy * spriteWidth + sx];

        vec4 c = vec4(
            float(texel & 0xFFu),
            float((texel >> 8) & 0xFFu),
            float((texel >> 16) & 0xFFu),
            float((texel >> 24) & 0xFFu)) / 255.0;
        if (c.w == 0.0)
            continue;

        int flags = tris[index].flags;
        vec4 hue;
        if ((flags & 2) != 0)
        {
            hue = vec4(tris[index].hue[0], tris[index].hue[1], tris[index].hue[2], tris[index].hue[3]);
        }
        else
        {
            hue = w0 * vec4(tris[index].hue[0], tris[index].hue[1], tris[index].hue[2], tris[index].hue[3])
                + w1 * vec4(tris[index].hue[4], tris[index].hue[5], tris[index].hue[6], tris[index].hue[7])
                + w2 * vec4(tris[index].hue[8], tris[index].hue[9], tris[index].hue[10], tris[index].hue[11]);
        }

        int mode = int(hue.w);

        if ((flags & 1) != 0)
        {
            if (mode == 1 || (mode == 2 && c.x == c.y && c.x == c.z))
            {
                c.xyz = getRgb(c.x, int(hue.x));
            }
            else if (mode == 255)
            {
                c.xyz += hue.xyz;
            }

            if (mode != 255)
                c *= hue.z;
        }
        else
        {
            if (flag > 0.0)
            {
                vec3 n = w0 * vec3(tris[index].normal[0], tris[index].normal[1], tris[index].normal[2])
                       + w1 * vec3(tris[index].normal[3], tris[index].normal[4], tris[index].normal[5])
                       + w2 * vec3(tris[index].normal[6], tris[index].normal[7], tris[index].normal[8]);
                c.xyz *= getLight(n);
            }

            if (mode == 255)
                c.xyz += hue.xyz;
        }

        color = c + color * (1.0 - c.w);
        depthBuffer = depth;
    }

    if (color.w > 0.0 && color.w < 1.0)
        color.xyz *= 1.0 / color.w;

    // R in the low byte, which is the byte order of the RGBA the image writers expect.
    outputPixels[y * params.width + x] =
        toByte(color.x) | (toByte(color.y) << 8) | (toByte(color.z) << 16) | (toByte(color.w) << 24);
}
